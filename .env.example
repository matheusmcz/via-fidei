# Supabase — padrão do quickstart Next.js
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Integração Vercel ↔ Supabase costuma injetar estes nomes (sem NEXT_PUBLIC_).
# O projeto aceita como fallback; em next.config.ts eles são espelhados para o cliente.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=

# Chave service_role (apenas servidor / npm run seed) — Project Settings → API
# https://supabase.com/docs/guides/api/api-keys
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transição: se ainda não tiver publishable, pode usar a anon JWT legada no cliente:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Testes do banco (projeto Vitest `db`, VF-098) — arquivo separado: .env.test
# Ele aponta só para o Supabase LOCAL e NÃO é versionado (o .gitignore cobre
# .env.test*). Não precisa preencher nada à mão: com o stack local no ar, rode
#
#   npx supabase start
#   npm run test:db:env
#
# que grava o .env.test com NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY do stack local.
# Nunca aponte o .env.test para um projeto real: os testes recusam host que não
# seja 127.0.0.1/localhost/::1 e falham na hora.

# Opcional — npm run bootstrap-users (admin + editor de teste no Auth e editor_churches)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# EDITOR_EMAIL=
# EDITOR_PASSWORD=
# ADMIN_NAME=
# EDITOR_NAME=
# EDITOR_CHURCH_ID=
